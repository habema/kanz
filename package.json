{
  "name": "kanz",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck": "tsc --build && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "codegen": "pnpm --filter @kanz/api-spec run codegen",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  }
}
